# Copy to .env and fill in locally. Never put real keys in this template.
DEEPSEEK_API_KEY=your_deepseek_key
OPENAI_API_KEY=your_openai_key

# Local data is preserved across restarts.
DATABASE_URL=sqlite:///./arbiter.db
CHECKPOINT_DB=checkpoints.db
ROUTING_TABLE=routing_table.json
ARBITER_LLM_TIMEOUT=30
